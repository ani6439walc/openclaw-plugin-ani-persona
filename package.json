{
  "name": "openclaw-plugin-ani-persona",
  "version": "0.1.0",
  "description": "Rewrite outgoing OpenClaw replies with a tool-free Ani completion.",
  "type": "module",
  "license": "MIT",
  "files": ["dist/", "skills/", "openclaw.plugin.json", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": { "node": "^24.16.0 || >=26.1.0" },
  "peerDependencies": { "openclaw": "2026.10.3" },
  "peerDependenciesMeta": { "openclaw": { "optional": true } },
  "devDependencies": { "@types/node": "26.6.5", "typescript": "7.0.2" },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": { "pluginApi": "2026.10.3", "minGatewayVersion": "2026.10.3" },
    "build": { "openclawVersion": "2026.10.3", "pluginSdkVersion": "2026.10.3" }
  }
}
