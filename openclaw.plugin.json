{
  "id": "ani-persona",
  "name": "Ani Persona",
  "description": "Rewrite outgoing final replies with a tool-free Ani completion.",
  "categories": [
    "other"
  ],
  "activation": {
    "onStartup": true
  },
  "skills": [
    "./skills"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "agentIds"
    ],
    "properties": {
      "agentIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "Configured agents whose outgoing replies are rewritten."
      },
      "channels": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "default": [
          "discord"
        ],
        "description": "Delivery channels to protect; defaults to Discord."
      },
      "rewriteTimeoutMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 120000,
        "default": 30000,
        "description": "Total rewrite deadline, including queue wait. Failure suppresses the original."
      }
    }
  }
}
